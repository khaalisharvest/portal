# ════════════════════════════════════════════════════════════════════════════
# Khaalis Harvest — Environment Variables
# Copy this file to .env (root) and fill in all REQUIRED values before
# running `docker compose up` or starting the apps locally.
#
# Variables marked  # REQUIRED  must be set; the app will refuse to start
# if they are missing.
# Variables marked  # OPTIONAL  have sensible defaults shown after "default:".
# ════════════════════════════════════════════════════════════════════════════


# ── Database ─────────────────────────────────────────────────────────────────

# Full Postgres connection string used by the NestJS backend (TypeORM/Prisma).
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5433/khaalis_harvest  # REQUIRED

# Credentials used by the docker-compose Postgres service.
DB_PASSWORD=your-db-password           # REQUIRED
DB_NAME=khaalis_harvest                # OPTIONAL — default: khaalis_harvest
DB_USERNAME=postgres                   # OPTIONAL — default: postgres
DB_PORT=5433                           # OPTIONAL — default: 5433

# Optional: override the Postgres startup command inside Docker.
# POSTGRES_COMMAND=                    # OPTIONAL


# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_HOST=localhost                   # REQUIRED
REDIS_PORT=6379                        # REQUIRED
REDIS_TTL=3600                         # REQUIRED — cache TTL in seconds
REDIS_PASSWORD=                        # OPTIONAL — leave blank for no auth

# Port exposed by the docker-compose Redis service.
# REDIS_PORT=6379                      # OPTIONAL — default: 6379

# Optional: override the Redis startup command inside Docker.
# REDIS_COMMAND=                       # OPTIONAL


# ── Application ──────────────────────────────────────────────────────────────

NODE_ENV=development                   # REQUIRED — development | production | test
PORT=3001                              # REQUIRED — NestJS backend listen port


# ── Security / Auth ──────────────────────────────────────────────────────────

# Shared between the NestJS backend and the Next.js BFF (route handlers).
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-production  # REQUIRED
JWT_EXPIRES_IN=7d                      # REQUIRED — e.g. 7d, 24h, 3600s


# ── URLs ─────────────────────────────────────────────────────────────────────

# Public URL of the Next.js frontend (used by the backend for CORS & links).
FRONTEND_URL=http://localhost:3000     # REQUIRED

# Public URL of the admin panel if hosted separately; otherwise same as FRONTEND_URL.
ADMIN_URL=http://localhost:3000        # REQUIRED

# Public URL of the NestJS backend API.
BACKEND_URL=http://localhost:3001      # REQUIRED

# Comma-separated list of origins the backend will accept CORS requests from.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001  # REQUIRED

# Used by the Next.js server-side BFF to talk to the backend (may be an
# internal Docker network address in production).
NEXT_PUBLIC_API_URL=http://localhost:3001    # REQUIRED (frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000   # REQUIRED (frontend)
INTERNAL_BACKEND_URL=http://backend:3001   # OPTIONAL — Docker internal URL; falls back to BACKEND_URL

# Optional override used by some frontend components.
# NEXT_PUBLIC_API_BASE_URL=            # OPTIONAL


# ── Frontend — App Identity ───────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=Khaalis Harvest              # OPTIONAL — default: Khaalis Harvest
NEXT_PUBLIC_APP_DESCRIPTION=Pakistan's premium organic marketplace  # OPTIONAL
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR                  # OPTIONAL — default: PKR
NEXT_PUBLIC_DEFAULT_LANGUAGE=en                   # OPTIONAL — default: en


# ── Notifications (Backend) ──────────────────────────────────────────────────

# "From" address on all outgoing emails.
SMTP_FROM=noreply@example.com          # REQUIRED

# Admin contact — receives order notifications, alerts, etc.
ADMIN_EMAIL=admin@example.com          # REQUIRED
ADMIN_WHATSAPP=+92300XXXXXXX           # REQUIRED — E.164 format

# SMTP credentials — if absent, emails are logged to console only.
SMTP_HOST=smtp.example.com             # OPTIONAL
SMTP_PORT=587                          # OPTIONAL
SMTP_USER=your-smtp-username           # OPTIONAL
SMTP_PASS=your-smtp-password           # OPTIONAL


# ── Frontend — Admin Contact ──────────────────────────────────────────────────

NEXT_PUBLIC_ADMIN_WHATSAPP=+92300XXXXXXX  # OPTIONAL — displayed on storefront
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com # OPTIONAL — displayed on storefront


# ── Frontend — Bank / Payment Details ────────────────────────────────────────

NEXT_PUBLIC_BANK_NAME=Your Bank Name                       # OPTIONAL
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Your Account Name            # OPTIONAL
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000000              # OPTIONAL
NEXT_PUBLIC_BANK_IBAN=PK00XXXX0000000000000000             # OPTIONAL


# ── File Uploads ─────────────────────────────────────────────────────────────

UPLOAD_PATH=./uploads                  # REQUIRED — local disk path for uploads
MAX_FILE_SIZE_MB=10                    # REQUIRED — max upload size in MB


# ── Cloudinary (Image CDN) ────────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name  # REQUIRED
CLOUDINARY_API_KEY=your-cloudinary-api-key        # REQUIRED
CLOUDINARY_API_SECRET=your-cloudinary-api-secret  # REQUIRED


# ── Error Tracking ────────────────────────────────────────────────────────────

# Sentry DSN — Sentry is disabled entirely when this variable is absent.
# SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX  # OPTIONAL


# ── Docker Resource Tuning ────────────────────────────────────────────────────

# Max Node.js heap size (in MB) for each service inside Docker.
# NODE_OPTIONS_BACKEND=512             # OPTIONAL — e.g. 512
# NODE_OPTIONS_FRONTEND=512            # OPTIONAL — e.g. 512
